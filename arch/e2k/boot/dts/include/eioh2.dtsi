		regbar-and-size64 = /bits/ 64 <PCICFG_ADDRL(20000010) 0x100000>;

		interrupt-parent = <&lpic>;
		interrupt-controller;
		numa-node-id = <NODE>;
		#interrupt-cells = <2>;
	};
	pci@DMN_2 {
		compatible = "mcst,l-pci";
		status = DMN_2_STS;
		REG = <PCICFG_ADDR(0x20000000) 0 0x10000000>,
			<NSR_ADDR(00248) 0 4>,
			<NSR_ADDR(00228) 0 4>,
			<NSR_ADDR(00268) 0 4>,
			<NSR_ADDR(00288) 0 4>;
		reg-names = "cfg", "io", "mem", "pref-bgn", "pref-end";

		linux,pci-domain = <DMN_2>;
		numa-node-id = <NODE>;
		interrupt-parent = <&PIC_2>;
		msi-parent = <&lmsi>;
		linux,pci-probe-only = <1>;

		/*rid-base,iommu,iommu-base,length*/
		iommu-map = <0x0 &IOMMU_2 0x0 0x10000>;
		/* 1:1 translation, max size (48-bit) of e2k address space */
		ranges = <  0 0 0 /* child address */
			      0 0 /* parent address */
			0x10000 0>;/* child size */
		#address-cells = <3>;
		#size-cells = <2>;
		/* reg: 00000000 00000000 dddddfff 00000000 */
		pci@0,0 {
			reg = <0x00000000 0 0 0 0>;
			ranges;
			#address-cells = <3>;
			#size-cells = <2>;
			pci@0,0 { /*CXL/PCIe Root complex x16*/
				reg = <0x00000000 0 0 0 0>;
				interrupts =	<1 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ A*/
						<2 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ B*/
						<3 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ C*/
						<4 IRQ_TYPE_LEVEL_HIGH>,  /*PCI IRQ D*/
						<5 IRQ_TYPE_LEVEL_HIGH>; /*error/hot-plug,link-drop*/
			};
			pci@1,0 { /*CXL/PCIe Root complex x8*/
				reg = <0x00000800 0 0 0 0>;
				interrupts =	< 6 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ A*/
						< 7 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ B*/
						< 8 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ C*/
						< 9 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ D*/
						<10 IRQ_TYPE_LEVEL_HIGH>; /*error/hot-plug,link-drop*/
			};
			pci@2,0 { /*CXL/PCIe Root complex x8*/
				reg = <0x00001000 0 0 0 0>;
				interrupts =	<11 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ A*/
						<12 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ B*/
						<13 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ C*/
						<14 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ D*/
						<15 IRQ_TYPE_LEVEL_HIGH>; /*error/hot-plug,link-drop*/
			};
			pci@3,0 { /*CXL/PCIe Root complex x8*/
				reg = <0x00001800 0 0 0 0>;
				interrupts =	<16 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ A*/
						<17 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ B*/
						<18 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ C*/
						<18 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ D*/
						<20 IRQ_TYPE_LEVEL_HIGH>; /*error/hot-plug,link-drop*/
			};
		};
	};

	IOMMU_3: iommu@DMN_3 {
		compatible = "mcst,e2k-iommu";
		status = DMN_3_STS;
		REG = <NSR_ADDR(0c380) 0 0x80>;
		#iommu-cells = <1>;
		numa-node-id = <NODE>;
		interrupt-parent = <&LVT>;
		interrupts = <LINP18_INTERRUPT_VECTOR 18 0>;
