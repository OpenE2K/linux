#ifndef CELLS
# error CELLS undefined
#endif

#if CELLS == 1
# define REG reg32
#else
# define REG reg
#endif

#define __IOMMU(_n) iommu ## _n
#define _IOMMU(_n) __IOMMU(_n)
#define IOMMU _IOMMU(NODE)

#define __GPIO(_n) l_gpio ## _n
#define _GPIO(_n) __GPIO(_n)
#define L_GPIO _GPIO(NODE)

#define __PCICFG_ADDRL(_a, _n) 0x2 ## _n ## _a
#define _PCICFG_ADDRL(_a, _n) __PCICFG_ADDRL(_a, _n)
#define PCICFG_ADDRL(_a) _PCICFG_ADDRL(_a, NODE)

#define __PCICFG_ADDR(_a, _n) 0x2 0x0 ## _n ## _a
#define _PCICFG_ADDR(_a, _n) __PCICFG_ADDR(_a, _n)
#define PCICFG_ADDR(_a) _PCICFG_ADDR(_a, NODE)

	PIC: PIC {
		compatible = "mcst,ioapic";

		bus-reg64         = /bits/ 64 <PCICFG_ADDRL(0000018) 4>;
		regbar-and-size64 = /bits/ 64 <PCICFG_ADDRL(0011040) 20>;

		interrupt-parent = <&lpic>;
		interrupt-controller;
		numa-node-id = <NODE>;

		#interrupt-cells = <2>;
	};

	IOMMU: iommu@NODE,380 {
		compatible = "mcst,l-iommu";
		REG = <NSR_ADDR(00380) 0 0x80>;

		#iommu-cells = <1>;

		numa-node-id = <NODE>;
		interrupt-parent = <&LVT>;
		interrupts = <LVT3_INTERRUPT_VECTOR 3 0>;
	};

	pci@NODE {
		compatible = "mcst,l-pci";
		REG = <PCICFG_ADDR(0000000) 0 0x10000000>, /*E2S_PCICFG_AREA_PHYS_BASE*/
			<NSR_ADDR(00050) 0 4>, /*SIC_rt_pciio0*/
			<NSR_ADDR(00040) 0 4>, /*SIC_rt_pcim0*/
			<NSR_ADDR(00070) 0 4>, /*SIC_rt_pcimp_b0*/
			<NSR_ADDR(00080) 0 4>; /*SIC_rt_pcimp_e0*/
		reg-names = "cfg", "io", "mem", "pref-bgn", "pref-end";

		linux,pci-domain = <NODE>;
		numa-node-id = <NODE>;
		msi-parent = <&lmsi>;
		linux,pci-probe-only = <1>;
		/*rid-base,iommu,iommu-base,length*/
		iommu-map = <0x0 &IOMMU 0x0 0x10000>;
		/* 1:1 translation, max size (48-bit) of e2k address space */
		ranges = <0 0 0 /* child address */
#if CELLS == 1
			    0   /* parent address */
#elif CELLS == 2
			    0 0 /* parent address */
#else
# error CELLS not supported
#endif
			0x10000 0>;/* child size */
		interrupt-parent = <&PIC>;
		interrupts = <22 IRQ_TYPE_LEVEL_HIGH>; /*SERR (all devices)*/

		#address-cells = <3>;
		#size-cells = <2>;

		/* reg: 00000000 00000000 dddddfff 00000000 */
		pci@0,0 {
			reg = <0x00000000 0 0 0 0>;
			ranges;

			#address-cells = <3>;
			#size-cells = <2>;

			interrupts =	<16 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ A*/
					<17 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ B*/
					<18 IRQ_TYPE_LEVEL_HIGH>, /*PCI IRQ C*/
					<19 IRQ_TYPE_LEVEL_HIGH>; /*PCI IRQ D*/

			/* pci@0,0 PCI-to-PCI Bridge */

			pci@1,0 { /*Ethernet controller*/
				reg = <0x00000800 0 0 0 0>;
				interrupts = <4 IRQ_TYPE_LEVEL_HIGH>;
			};
			pci@1,1 { /*Ethernet controller*/
				reg = <0x00000900 0 0 0 0>;
				interrupts = <10 IRQ_TYPE_LEVEL_HIGH>;
			};
			pci@1,2 { /*Ethernet controller*/
				reg = <0x00000a00 0 0 0 0>;
				interrupts = <14 IRQ_TYPE_LEVEL_HIGH>;
			};
			pci@2,0 { /*IDE controller*/
				reg = <0x00001000 0 0 0 0>;
				interrupts = <11 IRQ_TYPE_LEVEL_HIGH>;
			};
			pci@2,1 { /*i2c-spi*/
				reg = <0x000001100 0 0 0 0>;
				interrupts =	<15 IRQ_TYPE_LEVEL_HIGH>, /*I2C-SPI*/
						< 8 IRQ_TYPE_LEVEL_HIGH>; /* WD Timer*/
			};
			pci@2,2 { /*Serial and Parallel ports*/
				reg = <0x00001200 0 0 0 0>;
				interrupts =	< 3 IRQ_TYPE_LEVEL_HIGH>, /*Serial Port*/
						< 7 IRQ_TYPE_LEVEL_HIGH>; /*Parallel Port*/
			};
			pci@2,3 { /*Audio controller*/
				reg = <0x00001300 0 0 0 0>;
				interrupts = <5 IRQ_TYPE_LEVEL_HIGH>;
			};
			pci@2,4 { /*GPIO-MPV controller*/
				reg = <0x00001400 0 0 0 0>;

				#address-cells = <2>;
				#size-cells = <1>;

				/*ranges will added in gpio-mpv driver */
				L_GPIO: gpio@0 {
					compatible = "mcst,l-gpio";
					reg = <0 /*bar 0*/ 0 32>;
					interrupts = < 7 IRQ_TYPE_LEVEL_HIGH>, /*GPIO0*/
						     <11 IRQ_TYPE_LEVEL_HIGH>; /*GPIO1*/
					interrupt-names = "gpio0", "gpio1";
					ngpios = <32>;
				};
				mpv@0 {
					reg = <1 /*bar 1*/ 0 128>;
					compatible = "mcst,mpv";
					interrupts = < 6 IRQ_TYPE_LEVEL_HIGH>, /*Mpv_timers0*/
						     < 9 IRQ_TYPE_LEVEL_HIGH>; /*Mpv_timers12*/
					interrupt-names = "mpv0", "mpv1", "mpv2";
				};
			};
			pci@3,0 { /*SATA controller*/
				reg = <0x00001800 0 0 0 0>;
				interrupt-parent = <&PIC>;
				interrupts = <20 IRQ_TYPE_LEVEL_HIGH>;
			};
			pci@3,1 { /*SATA controller*/
				reg = <0x00001900 0 0 0 0>;
				interrupt-parent = <&PIC>;
				interrupts = <21 IRQ_TYPE_LEVEL_HIGH>;
			};
			pci@4,0 { /*PCIe bridge*/
				reg = <0x00002000 0 0 0 0>;
			};
			pci@5,0 { /*PCIe bridge*/
				reg = <0x00002800 0 0 0 0>;
			};
			pci@6,0 { /*PCIe bridge*/
				reg = <0x00003000 0 0 0 0>;
			};
			pci@7,0 { /*PCIe bridge*/
				reg = <0x00003800 0 0 0 0>;
			};
			pci@8,0 { /*PCIe bridge*/
				reg = <0x00004000 0 0 0 0>;
			};
			pci@9,0 { /*PCIe bridge*/
				reg = <0x00004800 0 0 0 0>;
			};
			pci@a,0 { /*USB Controller (ohci)*/
				reg = <0x00005000 0 0 0 0>;
				interrupts = <12 IRQ_TYPE_LEVEL_HIGH>;
			};
			pci@a,1 { /*USB Controller (ehci)*/
				reg = <0x00005100 0 0 0 0>;
				interrupts = <12 IRQ_TYPE_LEVEL_HIGH>;
			};
			pci@b,0 { /*USB Controller (ohci)*/
				reg = <0x00005800 0 0 0 0>;
				interrupts = <13 IRQ_TYPE_LEVEL_HIGH>;
			};
			pci@b,1 { /*USB Controller (ehci)*/
				reg = <0x00005900 0 0 0 0>;
				interrupts = <13 IRQ_TYPE_LEVEL_HIGH>;
			};
			pci@c,0 { /*SPMC System Power Managment Controller*/
				reg = <0x00006000 0 0 0 0>;
				interrupts = <1 IRQ_TYPE_LEVEL_HIGH>;
			};
		};
	};
