#define __PIC(_n) pic ## _n
#define _PIC(_n) __PIC(_n)
#define PIC _PIC(NODE)

#define __LVT(_n) lvt ## _n
#define _LVT(_n) __LVT(_n)
#define LVT _LVT(NODE)

#define __NSR_ADDR(_a, _n) 0x1 0x10 ## _n ## _a
#define _NSR_ADDR(_a, _n) __NSR_ADDR(_a, _n)
#define NSR_ADDR(_a) _NSR_ADDR(_a, NODE)

#define __SIC(_n) sic ## _n
#define _SIC(_n) __SIC(_n)
#define SIC _SIC(NODE)

#define __PMC_FREQ(_n) pmc_freq ## _n
#define _PMC_FREQ(_n) __PMC_FREQ(_n)
#define PMC_FREQ _PMC_FREQ(NODE)

#define __PCSM_DRV(_n) pcsm_drv ## _n
#define _PCSM_DRV(_n) __PCSM_DRV(_n)
#define PCSM_DRV _PCSM_DRV(NODE)

#define __UNCORE_MC(_n) uncore_mc ## _n
#define _UNCORE_MC(_n) __UNCORE_MC(_n)
#define UNCORE_MC _UNCORE_MC(NODE)

#define __L_PCS(_n) l_pcs ## _n
#define _L_PCS(_n) __L_PCS(_n)
#define L_PCS _L_PCS(NODE)
