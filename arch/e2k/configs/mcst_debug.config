#
# Self-checking options for debug
#
CONFIG_SEMI_SPEC_LOADS_INJECTION=y
CONFIG_NESTED_PAGE_FAULT_INJECTION=y
CONFIG_TEST_PAGE_OFFSET_PAGE_COLLAPSE=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_TEST_KERNEL_PT_SYNC=m
CONFIG_TEST_HYPERCALLS_LOOP=y

# Works together with CONFIG_DEBUG_VM to catch invalid kernel mappings
CONFIG_MARK_KERNEL_PAGE_TABLES=y

# Fault injection mechanism is needed to speed up pool test
CONFIG_FAULT_INJECTION=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y
CONFIG_TEST_POOL=m
